{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverside-pivot.dev/schema/pivot-runtime-response-v1.json",
  "title": "Pivot Runtime Protocol Response V1",
  "type": "object",
  "required": ["schemaVersion", "kind", "status", "payload"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": {
      "enum": ["data", "filter_options", "chart", "detail", "drill", "update", "transaction", "export"]
    },
    "status": { "type": "string", "minLength": 1 },
    "requestId": { "type": "string", "minLength": 1 },
    "table": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "clientInstance": { "type": "string", "minLength": 1 },
    "stateEpoch": { "type": "integer", "minimum": 0 },
    "windowSeq": { "type": "integer", "minimum": 0 },
    "message": { "type": "string" },
    "payload": { "anyOf": [{ "$ref": "#/$defs/exportJobPayload" }, { "$ref": "#/$defs/jsonObject" }] },
    "profile": { "$ref": "#/$defs/jsonObject" }
  },
  "additionalProperties": false,
  "allOf": [{
    "$comment": "This conditional only narrows declared fields; it does not add an open object to generated TypeScript.",
    "tsType": "unknown",
    "if": {
      "properties": {
        "kind": { "const": "export" }
      },
      "required": ["kind", "payload"],
      "anyOf": [
        { "properties": { "status": { "const": "export_job" } }, "required": ["status"] },
        { "properties": { "payload": { "anyOf": [{ "required": ["jobId"] }, { "required": ["phase"] }] } } }
      ]
    },
    "then": { "properties": { "payload": { "$ref": "#/$defs/exportJobPayload" } } }
  }],
  "$defs": {
    "exportJobPayload": {
      "type": "object",
      "required": ["jobId", "phase", "rowsWritten", "bytesWritten", "totalRows"],
      "properties": {
        "jobId": { "type": "string", "minLength": 1 },
        "phase": { "enum": ["queued", "running", "cancelling", "cancelled", "completed", "failed", "interrupted"] },
        "rowsWritten": { "type": "integer", "minimum": 0 },
        "bytesWritten": { "type": "integer", "minimum": 0 },
        "totalRows": { "type": ["integer", "null"], "minimum": 0 },
        "payloadRef": { "$ref": "#/$defs/jsonObject", "minProperties": 1 }
      },
      "allOf": [{
        "tsType": "unknown",
        "if": { "properties": { "phase": { "const": "completed" } }, "required": ["phase"] },
        "then": { "required": ["payloadRef"] },
        "else": { "not": { "required": ["payloadRef"] } }
      }],
      "additionalProperties": false
    },
    "jsonValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "$ref": "#/$defs/jsonObject" }
      ]
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    }
  }
}
