{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverside-pivot.dev/schema/pivot-runtime-request-v1.json",
  "title": "Pivot Runtime Protocol Request V1",
  "type": "object",
  "required": ["schemaVersion", "kind", "requestId", "payload"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": {
      "enum": ["data", "filter_options", "chart", "detail", "drill", "update", "transaction", "export"]
    },
    "requestId": { "type": "string", "minLength": 1 },
    "table": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "clientInstance": { "type": "string", "minLength": 1 },
    "stateEpoch": { "type": "integer", "minimum": 0 },
    "windowSeq": { "type": "integer", "minimum": 0 },
    "abortGeneration": { "type": "integer", "minimum": 0 },
    "cacheKey": { "type": "string" },
    "state": { "$ref": "#/$defs/viewState" },
    "payload": { "anyOf": [{ "$ref": "#/$defs/exportPayload" }, { "$ref": "#/$defs/jsonObject" }] }
  },
  "additionalProperties": false,
  "allOf": [{
    "$comment": "This conditional only narrows declared fields; it does not add an open object to generated TypeScript.",
    "tsType": "unknown",
    "if": { "properties": { "kind": { "const": "export" } }, "required": ["kind"] },
    "then": { "properties": { "payload": { "$ref": "#/$defs/exportPayload" } } }
  }],
  "$defs": {
    "exportPayload": {
      "type": "object",
      "properties": {
        "action": { "enum": ["start", "status", "cancel"] },
        "jobId": { "type": "string", "minLength": 1 }
      },
      "allOf": [{ "$ref": "#/$defs/jsonObject" }, {
        "tsType": "unknown",
        "if": { "properties": { "action": { "enum": ["status", "cancel"] } }, "required": ["action"] },
        "then": { "required": ["jobId"] },
        "else": { "not": { "required": ["jobId"] } }
      }],
      "additionalProperties": true
    },
    "jsonValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "$ref": "#/$defs/jsonObject" }
      ]
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "viewState": {
      "type": "object",
      "properties": {
        "rowFields": { "type": "array", "items": { "type": "string" } },
        "colFields": { "type": "array", "items": { "type": "string" } },
        "valConfigs": { "type": "array", "items": { "$ref": "#/$defs/jsonObject" } },
        "filters": { "$ref": "#/$defs/jsonObject" },
        "customDimensions": { "type": "array", "items": { "$ref": "#/$defs/jsonObject" } },
        "measureAxis": { "$ref": "#/$defs/jsonObject" },
        "sorting": { "type": "array", "items": { "$ref": "#/$defs/jsonObject" } },
        "sortOptions": { "$ref": "#/$defs/jsonObject" },
        "expanded": {
          "anyOf": [
            { "type": "boolean" },
            { "$ref": "#/$defs/jsonObject" }
          ]
        },
        "immersiveMode": { "type": "boolean" },
        "showRowTotals": { "type": "boolean" },
        "showColTotals": { "type": "boolean" },
        "showSubtotals": { "type": "boolean" },
        "groupAllowUnbalanced": { "type": "boolean" },
        "unbalancedValues": { "anyOf": [{ "type": "array", "items": { "$ref": "#/$defs/jsonValue" } }, { "type": "null" }] },
        "showGrandTotal": { "anyOf": [{ "type": "boolean" }, { "type": "null" }] },
        "viewMode": { "type": "string" },
        "detailMode": { "type": "string" },
        "treeConfig": { "anyOf": [{ "$ref": "#/$defs/jsonObject" }, { "type": "null" }] },
        "detailConfig": { "anyOf": [{ "$ref": "#/$defs/jsonObject" }, { "type": "null" }] },
        "reportDef": { "anyOf": [{ "$ref": "#/$defs/jsonObject" }, { "type": "null" }] }
      },
      "additionalProperties": false
    }
  }
}
