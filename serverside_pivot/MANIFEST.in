include serverside_pivot/*.js
include serverside_pivot/*.txt
include serverside_pivot/package-info.json
include package.json
include streamlit_pivot/pyproject.toml
recursive-include streamlit_pivot/frontend/build *
include pivot_engine/pivot_engine/runtime/runtime-contract.schema.json
include pivot_engine/pivot_engine/runtime/runtime-response.schema.json

# Never let locally generated build output or npm's dependency tree enter an
# sdist.  Besides keeping distributions small, this forces every wheel to use
# the explicit package-data declarations in pyproject.toml.
prune build
prune node_modules
prune serverside_pivot/build
prune serverside_pivot/node_modules
prune streamlit_pivot/frontend/node_modules
global-exclude __pycache__
global-exclude *.py[cod]
