{
  "name": "serverside_pivot",
  "version": "0.0.91",
  "description": "Enterprise-grade analytical pivot table & virtualized data grid for React. Dual-engine: zero-network in-browser analytics (DuckDB-WASM & in-memory) and scalable server-side pushdown. Built with TanStack Table v8, ECharts 6, and 2D virtualization.",
  "main": "./dist/react/index.mjs",
  "types": "./dist/react/react.d.ts",
  "files": [
    "dist/react",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/react/react.d.ts",
      "import": "./dist/react/index.mjs",
      "default": "./dist/react/index.mjs"
    },
    "./react": {
      "types": "./dist/react/react.d.ts",
      "import": "./dist/react/index.mjs",
      "default": "./dist/react/index.mjs"
    }
  },
  "scripts": {
    "start": "webpack-dev-server --config ./webpack.serve.config.js --open",
    "build:js": "webpack --mode production",
    "build:react": "vite build --config vite.react.config.mjs && tsc --project tsconfig.react.build.json",
    "build:streamlit": "npm --prefix streamlit_pivot/frontend ci && npm --prefix streamlit_pivot/frontend run build",
    "build:py": "python scripts/build_py_strict.py",
    "build": "npm run typecheck && npm run build:js && npm run build:react && npm run build:streamlit && npm run build:py",
    "prepack": "npm run build:react",
    "benchmark:runtime": "python ../scripts/benchmark_pivot_runtime.py",
    "benchmark:browser": "python ../scripts/benchmark_browser_runtime.py",
    "benchmark:flagship-transport": "python ../scripts/benchmark_flagship_transport.py",
    "certify:flagship": "python ../scripts/certify_flagship.py",
    "typecheck": "tsc --noEmit && npm run typecheck:js",
    "typecheck:js": "tsc --project tsconfig.checked-js.json --noEmit && node scripts/verify_checked_js_gate.mjs",
    "generate:runtime-contract-types": "json2ts -i pivot_engine/pivot_engine/runtime/runtime-contract.schema.json -o src/lib/runtime/runtime-contract.generated.ts && json2ts -i pivot_engine/pivot_engine/runtime/runtime-response.schema.json -o src/lib/runtime/runtime-response-contract.generated.ts"
  },
  "author": "Ramzy <ramzyelawady@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@tanstack/react-table": "^8.10.7",
    "@tanstack/react-virtual": "^3.0.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "echarts-gl": "^2.1.0",
    "file-saver": "^2.0.5",
    "ramda": "^0.26.1",
    "styled-components": "^5.3.11",
    "xlsx": "npm:@e965/xlsx@^0.20.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.5.4",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/preset-env": "^7.5.4",
    "@babel/preset-react": "^7.0.0",
    "@babel/preset-typescript": "^7.27.1",
    "@plotly/webpack-dash-dynamic-import": "^1.2.0",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "babel-loader": "^8.0.6",
    "css-loader": "^7.1.2",
    "json-schema-to-typescript": "^15.0.4",
    "npm": "^11.7.0",
    "prop-types": "^15.7.2",
    "react": "^16.8.6",
    "react-docgen": "^8.0.3",
    "react-dom": "^16.8.6",
    "style-loader": "^0.23.1",
    "typescript": "^5.8.3",
    "vite": "^6.2.2",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=16.8.6",
    "react-dom": ">=16.8.6",
    "styled-components": ">=5.3.0"
  },
  "engines": {
    "node": ">=8.11.0",
    "npm": ">=6.1.0"
  },
  "keywords": [
    "react",
    "pivot-table",
    "pivot-grid",
    "datagrid",
    "table",
    "tanstack-table",
    "duckdb-wasm",
    "analytics",
    "virtualized-table",
    "olap",
    "echarts",
    "data-visualization",
    "excel-formulas",
    "spreadsheet",
    "hybrid-pivot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ramzy22/serverside_pivot.git"
  },
  "homepage": "https://github.com/Ramzy22/serverside_pivot#readme",
  "bugs": {
    "url": "https://github.com/Ramzy22/serverside_pivot/issues"
  }
}
